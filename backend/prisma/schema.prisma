generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  password     String
  name         String?
  phone        String?
  avatar       String?     @db.LongText
  coverImage   String?     @db.LongText
  roleId       Int
  role         Role        @relation(fields: [roleId], references: [id])
  departmentId Int?
  department   Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id])
  teamId       Int?
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id])
  managedDepts Department[] @relation("DepartmentManager")
  ledTeams     Team[]                  @relation("TeamLeader")
  permissions  Permission[]
  transferLogs DepartmentTransferLog[] @relation("UserTransferLogs")
  notifications Notification[]
  authorPosts   Post[]                   @relation("AuthorPosts")
  approvedPosts Post[]                   @relation("ApprovedPosts")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique // e.g., "Super Admin", "Manager", "Leader", "Employee", "Intern"
  description String?
  users       User[]
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model Module {
  id          Int          @id @default(autoincrement())
  name        String       @unique // e.g., "Social", "CRM", "Recruiting", "Training"
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

enum ScopeLevel {
  PERSONAL
  TEAM
  DEPARTMENT
  GLOBAL
}

enum AccessLevel {
  CAN_VIEW
  CAN_EDIT
  CAN_APPROVE
  FULL_CONTROL
}

model Permission {
  id        Int        @id @default(autoincrement())
  roleId    Int?
  userId    Int?
  moduleId  Int
  action    String     // "CREATE", "READ", "UPDATE", "DELETE", "APPROVE"
  scope     ScopeLevel @default(PERSONAL)
  role      Role?      @relation(fields: [roleId], references: [id])
  user      User?      @relation(fields: [userId], references: [id])
  module    Module     @relation(fields: [moduleId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@unique([roleId, userId, moduleId, action])
}

model ResourceAccessShare {
  id           Int         @id @default(autoincrement())
  resourceType String      // 'Social', 'CRM', 'Recruiting', 'TeamPosts'
  resourceId   String      // ID bài viết, ID lead hoặc ID team
  sharedWithId Int         // ID User hoặc ID Team được nhận quyền
  sharedType   String      @default("USER") // "USER" hoặc "TEAM"
  accessLevel  AccessLevel @default(CAN_VIEW)
  expireAt     DateTime?   // Hạn ủy quyền tạm thời
  createdById  Int?        // Người thực hiện chia sẻ/ủy quyền
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([resourceType, resourceId, sharedWithId])
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  managerId   Int?
  manager     User?     @relation("DepartmentManager", fields: [managerId], references: [id])
  teams       Team[]
  users       User[]    @relation("DepartmentMembers")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Team {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  description  String?
  departmentId Int
  department   Department  @relation(fields: [departmentId], references: [id])
  leaderId     Int?
  leader       User?       @relation("TeamLeader", fields: [leaderId], references: [id])
  users        User[]      @relation("TeamMembers")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
}

model DepartmentTransferLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation("UserTransferLogs", fields: [userId], references: [id])
  fromDeptId    Int?
  fromDeptName  String?
  toDeptId      Int?
  toDeptName    String?
  fromTeamId    Int?
  fromTeamName  String?
  toTeamId      Int?
  toTeamName    String?
  reason        String?  @db.Text
  changedById   Int?
  changedByName String?
  createdAt     DateTime @default(now())
}

model SecurityAuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  userName  String?
  action    String   // e.g. MATRIX_UPDATE, ROLE_CREATE, ROLE_UPDATE, ROLE_DELETE, DAC_GRANT, DAC_REVOKE
  details   String   @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  desc      String   @db.Text
  type      String   @default("system") // "approval", "crm", "badge", "system", "meeting"
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([userId, read])
}

enum PostStatus {
  DRAFT
  PENDING_APPROVE
  APPROVED
  REJECTED
  PUBLISHED
}

model Post {
  id           Int        @id @default(autoincrement())
  title        String
  content      String     @db.LongText
  platforms    String     // JSON array or string e.g. '["FACEBOOK","TIKTOK"]'
  status       PostStatus @default(DRAFT)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  rejectReason String?    @db.Text
  authorId     Int
  author       User       @relation("AuthorPosts", fields: [authorId], references: [id])
  approvedById Int?
  approvedBy   User?      @relation("ApprovedPosts", fields: [approvedById], references: [id])
  mediaUrls    String?    @db.LongText
  hashtags     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@index([authorId, status])
  @@index([scheduledAt])
}


