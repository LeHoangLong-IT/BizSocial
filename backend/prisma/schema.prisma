generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  password     String
  name         String?
  phone        String?
  roleId       Int
  role         Role        @relation(fields: [roleId], references: [id])
  departmentId Int?
  department   Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id])
  teamId       Int?
  team         Team?        @relation("TeamMembers", fields: [teamId], references: [id])
  managedDepts Department[] @relation("DepartmentManager")
  ledTeams     Team[]                  @relation("TeamLeader")
  permissions  Permission[]
  transferLogs DepartmentTransferLog[] @relation("UserTransferLogs")
  createdAt    DateTime                @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique // e.g., "Super Admin", "Manager", "Leader", "Employee", "Intern"
  description String?
  users       User[]
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model Module {
  id          Int          @id @default(autoincrement())
  name        String       @unique // e.g., "Social", "CRM", "Recruiting", "Training"
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
}

model Permission {
  id        Int       @id @default(autoincrement())
  roleId    Int?
  userId    Int?
  moduleId  Int
  action    String    // "CREATE", "READ", "UPDATE", "DELETE", "APPROVE"
  role      Role?     @relation(fields: [roleId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
  module    Module    @relation(fields: [moduleId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([roleId, userId, moduleId, action])
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  managerId   Int?
  manager     User?     @relation("DepartmentManager", fields: [managerId], references: [id])
  teams       Team[]
  users       User[]    @relation("DepartmentMembers")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Team {
  id           Int         @id @default(autoincrement())
  name         String      @unique
  description  String?
  departmentId Int
  department   Department  @relation(fields: [departmentId], references: [id])
  leaderId     Int?
  leader       User?       @relation("TeamLeader", fields: [leaderId], references: [id])
  users        User[]      @relation("TeamMembers")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
}

model DepartmentTransferLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation("UserTransferLogs", fields: [userId], references: [id])
  fromDeptId    Int?
  fromDeptName  String?
  toDeptId      Int?
  toDeptName    String?
  fromTeamId    Int?
  fromTeamName  String?
  toTeamId      Int?
  toTeamName    String?
  reason        String?  @db.Text
  changedById   Int?
  changedByName String?
  createdAt     DateTime @default(now())
}

